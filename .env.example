# ---- required ---------------------------------------------------------
# The one irreducible deploy-time secret (PLAN §2.5). From @BotFather.
TG_BOT_TOKEN=123456:ABC-DEF...

# ---- who can use it ---------------------------------------------------
# Optional: skip the pairing-code dance. Your numeric Telegram id — ask
# @userinfobot if you don't know it.
# OWNER_ID=123456789

# ---- channel mode (optional) -----------------------------------------
# Set this and a link becomes a submission: the bot posts the note to the
# channel and replies with a link to the post. The bot must be an admin of
# the channel with "Post Messages".
# CHANNEL_ID=@my_rednote_channel

# ---- what gets sent ---------------------------------------------------
# auto  — hand CDN URLs to Telegram, stream through the bot when refused (default)
# url   — passthrough only
# upload— always stream through the bot
# MEDIA_MODE=auto

# still | video | both  — what to send for live photos (PLAN §4.6)
# LIVE_PHOTOS=still

# Top comments to fetch and attach. 0 disables the extra page fetch.
# COMMENTS=5

# TAGS_IN_CAPTION=true
# MAX_UPLOAD_BYTES=52428800

# ---- tuning -----------------------------------------------------------
# CACHE_SIZE=128
# CACHE_TTL_SECONDS=21600

# text (default) reads well in a terminal; json emits one object per line with
# a stable event name, for Alloy/Loki. See OBSERVABILITY.md.
# LOG_FORMAT=text

# Logs every incoming update, message text included. Useful when a message
# shape isn't being parsed; leave it off otherwise — a mistyped cookie would
# land in the log.
# DEBUG_UPDATES=false

# ---- routing XHS traffic elsewhere (optional) -------------------------
# Send everything XHS-bound — the sidecar's fetches, short-link resolution,
# comment scraping and media downloads — through an HTTP proxy, while
# Telegram keeps using this host's own connection. See "Giving XHS a
# different exit" in the README.
# XHS_PROXY=http://tailscale:1055

# Only needed for the bundled `tailscale` compose profile:
# TS_AUTHKEY=tskey-auth-...      # from the Tailscale admin console
# TS_EXIT_NODE=home-pi           # tailnet name of the machine at home
# TS_HOSTNAME=tg-rednote
